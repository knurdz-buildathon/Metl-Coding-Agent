# Metl Agent - Environment Configuration
#
# === Quick Start: Azure Foundry ===
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1                       # Your Azure deployment name
# OPENAI_API_KEY=sk-your-azure-api-key
# OPENAI_API_BASE=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# OPENAI_API_VERSION=2026-04-01-preview
# GITHUB_PAT=ghp_your_github_personal_access_token
#
# Azure Foundry model deployment examples: gpt-4.1, gpt-4.1-mini, gpt-4.1-nano, o4-mini, o3

# === LLM Provider (at least one required) ===
# OpenAI / Azure Foundry (recommended for the agent + Aider)
OPENAI_API_KEY=                            # Your Azure OpenAI API key
# Azure Foundry / custom OpenAI-compatible endpoint base URL
OPENAI_API_BASE=                           # e.g. https://my-resource.openai.azure.com/openai/deployments/my-deployment
# API version for custom endpoints
OPENAI_API_VERSION=                        # e.g. 2026-04-01-preview
# Optional organization ID (for OpenAI directly)
OPENAI_ORG_ID=
# Anthropic (alternative provider)
ANTHROPIC_API_KEY=
# Google
GOOGLE_GENERATIVE_AI_API_KEY=

# Preferred LLM for main agent loop
# For Azure Foundry: use "openai" as provider, deployment name as model
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1                          # Your Azure deployment name (gpt-4.1, gpt-4.1-mini, o4-mini, etc.)

# LLM for Aider (can be different from main agent)
# Aider picks up OPENAI_API_BASE automatically when set
AIDER_LLM_PROVIDER=openai
AIDER_LLM_MODEL=gpt-4.1                    # Can use a different Azure deployment for code generation

# === GitHub ===
GITHUB_PAT=
GITHUB_WEBHOOK_SECRET=

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Feature Flags ===
ENABLE_CURSOR_SDK=false
CURSOR_API_KEY=
ENABLE_V0=false
V0_API_KEY=

# === Agent Config ===
AGENT_MAX_STEPS=500
AGENT_CHECKPOINT_INTERVAL=5
PREVIEW_BASE_URL=http://localhost:4000

# === Server ===
CORS_ORIGINS=["*"]
API_KEY=

# === Sandbox ===
SANDBOX_BASE_DIR=/tmp/metl-workspaces
PREVIEW_PORT_RANGE_START=4000
PREVIEW_PORT_RANGE_END=4999